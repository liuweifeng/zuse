{
	"openapi": "3.1.0",
	"info": {
		"title": "Zuse API",
		"version": "1",
		"description": "Create cloud workspaces, talk to their agents, and get notified when they finish."
	},
	"servers": [
		{
			"url": "https://api.zuse.sh"
		}
	],
	"security": [
		{
			"apiKey": []
		}
	],
	"tags": [
		{
			"name": "Workspaces",
			"description": "Start cloud workspaces and check on them."
		},
		{
			"name": "Messages",
			"description": "Talk to a workspace's agent."
		},
		{
			"name": "Attachments",
			"description": "Upload files to attach to messages."
		},
		{
			"name": "Projects",
			"description": "Repositories you can create workspaces from."
		},
		{
			"name": "Providers",
			"description": "Agents and cloud machines available to you."
		},
		{
			"name": "Webhooks",
			"description": "Get notified when agents finish."
		}
	],
	"paths": {
		"/v1/api/workspaces": {
			"post": {
				"operationId": "create-workspace",
				"tags": [
					"Workspaces"
				],
				"summary": "Create workspace",
				"description": "Starts a cloud workspace on a fresh branch and, if you pass a `prompt`, sends it to the agent. The machine starts right away; poll [Get workspace](/api-reference/workspaces/get-workspace) or subscribe to [webhooks](/api-reference/webhook-signatures) to follow progress.",
				"parameters": [
					{
						"name": "Idempotency-Key",
						"in": "header",
						"required": false,
						"description": "Retrying with the same key returns the original result instead of repeating the action. Up to 200 characters.",
						"schema": {
							"type": "string",
							"maxLength": 200
						}
					}
				],
				"requestBody": {
					"required": false,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/ApiWorkspaceCreateRequest"
							}
						}
					}
				},
				"responses": {
					"201": {
						"description": "Workspace created. Replaying a request with the same `Idempotency-Key` returns `200` with the same workspace.",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"workspace": {
											"$ref": "#/components/schemas/ApiWorkspaceStatus"
										}
									},
									"required": [
										"workspace"
									]
								}
							}
						}
					},
					"400": {
						"description": "`invalid_json`, `invalid_request`, `invalid_prompt`, `cloud_project_required`, `agent_and_model_required`, `invalid_git_ref`, `invalid_idempotency_key`, `idempotency_key_mismatch`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"401": {
						"description": "`missing_api_key`, `invalid_api_key`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"403": {
						"description": "`cloud_entitlement_required`, `cloud_billing_hold`, `cloud_billing_period_missing`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"404": {
						"description": "`cloud_project_not_found`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"409": {
						"description": "`cloud_project_not_ready`, `cloud_snapshot_unavailable`, `cloud_branch_in_use:<workspaceId>`, `idempotency_key_reused_with_different_request`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"503": {
						"description": "`cloud_provider_unavailable`, `cloud_provider_required`, `api_content_encryption_not_configured`, `api_content_seal_failed`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			},
			"get": {
				"operationId": "list-workspaces",
				"tags": [
					"Workspaces"
				],
				"summary": "List workspaces",
				"description": "Lists every workspace on your account that hasn't been deleted, including ones started from the app or Slack.",
				"responses": {
					"200": {
						"description": "Your workspaces.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ApiWorkspaceList"
								}
							}
						}
					},
					"401": {
						"description": "`missing_api_key`, `invalid_api_key`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"403": {
						"description": "`cloud_entitlement_required`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/v1/api/workspaces/{workspaceId}": {
			"get": {
				"operationId": "get-workspace",
				"tags": [
					"Workspaces"
				],
				"summary": "Get workspace",
				"description": "Returns the state of a workspace and whether its agent is working.",
				"parameters": [
					{
						"name": "workspaceId",
						"in": "path",
						"required": true,
						"description": "Workspace ID.",
						"schema": {
							"type": "string",
							"examples": [
								"workspace_Q2x8mN4pR7sT1vWz"
							]
						}
					}
				],
				"responses": {
					"200": {
						"description": "The workspace.",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"workspace": {
											"$ref": "#/components/schemas/ApiWorkspaceStatus"
										}
									},
									"required": [
										"workspace"
									]
								}
							}
						}
					},
					"401": {
						"description": "`missing_api_key`, `invalid_api_key`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"403": {
						"description": "`cloud_entitlement_required`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"404": {
						"description": "`cloud_workspace_not_found`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/v1/api/workspaces/{workspaceId}/messages": {
			"post": {
				"operationId": "send-message",
				"tags": [
					"Messages"
				],
				"summary": "Send message",
				"description": "Sends a message to the workspace's agent. A paused workspace resumes automatically. Messages are queued while the agent is busy and handled in order.",
				"parameters": [
					{
						"name": "workspaceId",
						"in": "path",
						"required": true,
						"description": "Workspace ID.",
						"schema": {
							"type": "string",
							"examples": [
								"workspace_Q2x8mN4pR7sT1vWz"
							]
						}
					},
					{
						"name": "Idempotency-Key",
						"in": "header",
						"required": false,
						"description": "Retrying with the same key returns the original result instead of repeating the action. Up to 200 characters.",
						"schema": {
							"type": "string",
							"maxLength": 200
						}
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/ApiSendMessageRequest"
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Message accepted.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ApiSendMessageReceipt"
								}
							}
						}
					},
					"400": {
						"description": "`invalid_json`, `invalid_request`, `invalid_message`, `invalid_asset_id`, `invalid_idempotency_key`, `idempotency_key_mismatch`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"401": {
						"description": "`missing_api_key`, `invalid_api_key`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"403": {
						"description": "`cloud_entitlement_required`, `cloud_billing_hold`, `cloud_billing_period_missing`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"404": {
						"description": "`cloud_workspace_not_found`, `api_asset_not_found`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"409": {
						"description": "`workspace_not_accepting_messages`, `message_not_deliverable`, `idempotency_key_reused_with_different_request`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"503": {
						"description": "`cloud_workspace_state_contended`, `api_content_encryption_not_configured`, `api_content_seal_failed`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			},
			"get": {
				"operationId": "list-messages",
				"tags": [
					"Messages"
				],
				"summary": "List messages",
				"description": "Returns the conversation, oldest first. To follow a running workspace, keep passing the previous `latestSeq` as `afterSeq`. A page shorter than `limit` means you've caught up.",
				"parameters": [
					{
						"name": "workspaceId",
						"in": "path",
						"required": true,
						"description": "Workspace ID.",
						"schema": {
							"type": "string",
							"examples": [
								"workspace_Q2x8mN4pR7sT1vWz"
							]
						}
					},
					{
						"name": "afterSeq",
						"in": "query",
						"required": false,
						"description": "Return messages with a sequence number greater than this.",
						"schema": {
							"type": "integer",
							"minimum": 0,
							"default": 0
						}
					},
					{
						"name": "limit",
						"in": "query",
						"required": false,
						"description": "Maximum messages to return. Larger values are capped at 200.",
						"schema": {
							"type": "integer",
							"minimum": 1,
							"maximum": 200,
							"default": 200
						}
					}
				],
				"responses": {
					"200": {
						"description": "A page of messages.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ApiMessageList"
								}
							}
						}
					},
					"400": {
						"description": "`invalid_message_query`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"401": {
						"description": "`missing_api_key`, `invalid_api_key`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"403": {
						"description": "`cloud_entitlement_required`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"404": {
						"description": "`cloud_workspace_not_found`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/v1/api/workspaces/{workspaceId}/attachments": {
			"post": {
				"operationId": "upload-attachment",
				"tags": [
					"Attachments"
				],
				"summary": "Upload attachment",
				"description": "Uploads a file to a workspace so you can attach it to a message. Send the raw file as the body with its media type in `Content-Type`. Files can be up to 20 MiB.",
				"parameters": [
					{
						"name": "workspaceId",
						"in": "path",
						"required": true,
						"description": "Workspace ID.",
						"schema": {
							"type": "string",
							"examples": [
								"workspace_Q2x8mN4pR7sT1vWz"
							]
						}
					},
					{
						"name": "X-Zuse-File-Name",
						"in": "header",
						"required": false,
						"description": "Original file name, up to 255 characters. Defaults to `attachment`.",
						"schema": {
							"type": "string",
							"examples": [
								"error.png"
							]
						}
					},
					{
						"name": "Idempotency-Key",
						"in": "header",
						"required": false,
						"description": "Retrying with the same key returns the original result instead of repeating the action. Up to 200 characters.",
						"schema": {
							"type": "string",
							"maxLength": 200
						}
					}
				],
				"requestBody": {
					"required": true,
					"description": "The file's bytes.",
					"content": {
						"image/png": {
							"schema": {
								"type": "string",
								"format": "binary"
							}
						},
						"image/jpeg": {
							"schema": {
								"type": "string",
								"format": "binary"
							}
						},
						"image/gif": {
							"schema": {
								"type": "string",
								"format": "binary"
							}
						},
						"image/webp": {
							"schema": {
								"type": "string",
								"format": "binary"
							}
						},
						"image/avif": {
							"schema": {
								"type": "string",
								"format": "binary"
							}
						},
						"application/pdf": {
							"schema": {
								"type": "string",
								"format": "binary"
							}
						},
						"text/plain": {
							"schema": {
								"type": "string",
								"format": "binary"
							}
						},
						"text/markdown": {
							"schema": {
								"type": "string",
								"format": "binary"
							}
						},
						"application/json": {
							"schema": {
								"type": "string",
								"format": "binary"
							}
						},
						"application/zip": {
							"schema": {
								"type": "string",
								"format": "binary"
							}
						}
					}
				},
				"responses": {
					"201": {
						"description": "File uploaded.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ApiAssetCreated"
								}
							}
						}
					},
					"400": {
						"description": "`unsupported_asset_type`, `invalid_asset_size`, `invalid_asset_body`, `invalid_idempotency_key`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"401": {
						"description": "`missing_api_key`, `invalid_api_key`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"403": {
						"description": "`cloud_entitlement_required`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"404": {
						"description": "`cloud_workspace_not_found`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"409": {
						"description": "`workspace_not_accepting_messages`, `idempotency_key_reused_with_different_asset`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"503": {
						"description": "`api_asset_store_unavailable`, `api_content_encryption_not_configured`, `api_content_seal_failed`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/v1/api/projects": {
