	"webhooks": {
		"workspace.turn.completed": {
			"post": {
				"operationId": "workspace-turn-completed",
				"tags": [
					"Webhooks"
				],
				"summary": "Turn completed event",
				"description": "Zuse sends this `POST` to every registered endpoint when an agent finishes a turn. Verify the `zuse-signature` header before trusting the body, and use `zuse-event-id` to ignore duplicates. See [Verify webhooks](/api-reference/webhook-signatures).",
				"parameters": [
					{
						"name": "zuse-signature",
						"in": "header",
						"required": true,
						"description": "`t=<unix seconds>,v1=<hex>`, where `v1` is the HMAC-SHA256 of `<t>.<raw body>` keyed with your full `whsec_` secret.",
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "zuse-event-id",
						"in": "header",
						"required": true,
						"description": "Same as `eventId` in the body.",
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "zuse-delivery-attempt",
						"in": "header",
						"required": true,
						"description": "Attempt number, starting at 1.",
						"schema": {
							"type": "integer",
							"minimum": 1
						}
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/ApiWebhookTurnCompletedEvent"
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Return any 2xx status to acknowledge the event. Anything else is retried."
					}
				}
			}
		}
	},
