			"ApiMessage": {
				"type": "object",
				"properties": {
					"messageId": {
						"type": "string",
						"description": "Message ID.",
						"examples": [
							"msg_k3Jd9sLq2Pz8xVb1Nm4Tr7"
						]
					},
					"seq": {
						"type": "number",
						"description": "Increases by one for each message in the workspace.",
						"examples": [
							5
						]
					},
					"role": {
						"type": "string",
						"enum": [
							"user",
							"assistant"
						],
						"description": "Who wrote the message."
					},
					"text": {
						"type": "string",
						"description": "Message text. Agent replies are capped at 16,384 characters."
					},
					"status": {
						"type": "string",
