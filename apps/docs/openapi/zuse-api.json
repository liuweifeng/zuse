									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/v1/api/providers": {
			"get": {
				"operationId": "list-providers",
				"tags": [
					"Providers"
				],
				"summary": "List providers",
				"description": "Lists the cloud machine providers and sizes available to your account.",
				"responses": {
					"200": {
						"description": "Available providers.",
						"content": {
							"application/json": {
