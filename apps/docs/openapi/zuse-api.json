		"/v1/api/webhooks": {
			"post": {
				"operationId": "create-webhook",
				"tags": [
					"Webhooks"
				],
				"summary": "Create webhook",
				"description": "Registers an endpoint that receives an event whenever an agent finishes a turn in any of your workspaces. The response includes the signing secret, which is shown only once. You can register up to 20 endpoints.",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/ApiWebhookCreateRequest"
							}
						}
					}
				},
				"responses": {
					"201": {
						"description": "Endpoint registered.",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ApiWebhookCreated"
								}
							}
						}
					},
					"400": {
						"description": "`invalid_json`, `invalid_request`, `invalid_webhook_url`, `invalid_webhook_description`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"401": {
						"description": "`missing_api_key`, `invalid_api_key`",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"403": {
						"description": "`cloud_entitlement_required`",
						"content": {
							"application/json": {
								"schema": {
